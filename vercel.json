{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/analytics-admin",
      "destination": "/api/control?op=analytics-admin"
    },
    {
      "source": "/api/pagespeed",
      "destination": "/api/control?op=pagespeed"
    },
    {
      "source": "/api/crux",
      "destination": "/api/control?op=crux"
    },
    {
      "source": "/api/seo-history",
      "destination": "/api/control?op=seo-history"
    },
    {
      "source": "/api/agent-run",
      "destination": "/api/control?op=agent-run"
    },
    {
      "source": "/api/action-update",
      "destination": "/api/control?op=action-update"
    },
    {
      "source": "/api/system-status",
      "destination": "/api/control?op=system-status"
    },
    {
      "source": "/api/facebook-insights",
      "destination": "/api/control?op=facebook-insights"
    }
  ]
}
