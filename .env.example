# --- Dashboard / action protection ---
ADMIN_ACTION_KEY=replace-with-long-random-secret
MONITOR_SECRET=replace-with-long-random-secret

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- Google APIs ---
# One restricted API key for Chrome UX Report API + PageSpeed Insights API.
GOOGLE_API_KEY=

# --- Google service account (recommended) ---
# Add the service-account email as a user to all 4 GSC properties and GA4 properties.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Site configuration ---
# Replace GA4 IDs when available. GSC property values must exactly match GSC.
SITE_CONFIG_JSON=[{"id":"anytool","name":"AnyTool","domain":"anytool.online","url":"https://anytool.online","sitemap":"https://anytool.online/sitemap.xml","gscProperty":"sc-domain:anytool.online","ga4PropertyId":""},{"id":"kmafaq-online","name":"KMAFAQ Online","domain":"kmafaq.online","url":"https://kmafaq.online","sitemap":"https://kmafaq.online/sitemap.xml","gscProperty":"sc-domain:kmafaq.online","ga4PropertyId":""},{"id":"kmafaq-site","name":"KMAFAQ Site","domain":"kmafaq.site","url":"https://kmafaq.site","sitemap":"https://kmafaq.site/sitemap.xml","gscProperty":"sc-domain:kmafaq.site","ga4PropertyId":""},{"id":"scholarportal","name":"ScholarPortal","domain":"scholarportal.site","url":"https://scholarportal.site","sitemap":"https://scholarportal.site/sitemap.xml","gscProperty":"sc-domain:scholarportal.site","ga4PropertyId":""}]

# --- IndexNow ---
INDEXNOW_KEY=

# Optional: app URL used by scheduled monitors / links
PUBLIC_APP_URL=

# --- SEO history persistence (Supabase Edge Function) ---
# Set the same random secret in Vercel and Supabase Edge Function secrets.
SEO_STORAGE_SECRET=
SEO_STORE_URL=https://wikbbpvhvevcbqkpnikj.supabase.co/functions/v1/seo-store-v2

# --- Facebook Page Insights ---
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
